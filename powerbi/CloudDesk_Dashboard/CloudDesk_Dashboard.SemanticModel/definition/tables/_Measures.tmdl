	measure 'Avg Churn Probability' = AVERAGE ( churn_scores[churn_probability] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 47af4701-e236-490d-975a-d0b05797a1d5

	measure 'Avg Sessions per Seat' = AVERAGE ( fct_usage_monthly[sessions_per_seat] )
		formatString: 0.0
		lineageTag: 8327bea4-3f14-4965-9731-d04a1cff3892

	measure 'Forecast MRR' = ```
			
			        IF ( NOT ISCROSSFILTERED ( dim_accounts ) && NOT ISCROSSFILTERED ( dim_plans ),
			             CALCULATE ( SUM ( mrr_forecast[mrr] ), mrr_forecast[series] = "Forecast" ) )
			```
		formatString: \$#,0;-\$#,0;\$#,0
		lineageTag: 2b8bc83e-0143-406f-adae-5338ef822f07

	measure 'Forecast Lower 80%' = ```
			
			        IF ( NOT ISBLANK ( [Forecast MRR] ), CALCULATE ( SUM ( mrr_forecast[lower_80] ), mrr_forecast[series] = "Forecast" ) )
			```
		formatString: \$#,0;-\$#,0;\$#,0
		lineageTag: 0e9c7e97-8361-467c-a963-d677ee7ae5da

	measure 'Forecast Upper 80%' = ```
			
			        IF ( NOT ISBLANK ( [Forecast MRR] ), CALCULATE ( SUM ( mrr_forecast[upper_80] ), mrr_forecast[series] = "Forecast" ) )
			```
		formatString: \$#,0;-\$#,0;\$#,0
